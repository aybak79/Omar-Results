---
interface Props {
  ctaHref: string;
}
const { ctaHref } = Astro.props;
---
<header class="site-header" id="top">
  <div class="container site-header__inner">
    <a class="wordmark" href="#top" aria-label="Omar Results, back to top">
      <span class="wordmark__mark" aria-hidden="true"></span>
      <span class="wordmark__text">Omar Results</span>
    </a>
    <a class="btn btn--call" href={ctaHref}><slot /></a>
  </div>
</header>
