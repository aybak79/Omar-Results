---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <div class="marquee__group">
        {items.map((item) => (<><span>{item}</span><i>✦</i></>))}
      </div>
    ))}
  </div>
</div>
