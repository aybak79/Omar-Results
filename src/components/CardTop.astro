---
// Icon tile + number badge used at the top of cards and letter boxes.
// Pass the icon's inner SVG markup through the default slot.
interface Props {
  num: string;
  slate?: boolean;
  badgeStyle?: string;
}
const { num, slate = false, badgeStyle } = Astro.props;
---
<div class="card__top">
  <span class:list={["icon-block", { "icon-block--slate": slate }]} aria-hidden="true"><svg viewBox="0 0 24 24"><slot /></svg></span>
  <span class="num-badge" aria-hidden="true" style={badgeStyle}>{num}</span>
</div>
